# ─── API ───────────────────────────────────────────────────
# URL de base de l'API Haivoly. OBLIGATOIRE pour un build APK : un APK
# installé n'a pas de bundler Expo à retrouver.
# Ne jamais laisser une IP de box ici en production : elle change.
# Renseigner l'URL publique du backend (https://api.votredomaine.mg).
EXPO_PUBLIC_API_URL=https://api.votredomaine.mg

# Délai maximal d'une requête HTTP (ms)
EXPO_PUBLIC_API_TIMEOUT=15000

# Intervalle de synchronisation automatique de la file hors-ligne (ms)
EXPO_PUBLIC_SYNC_INTERVAL=20000

# Nombre maximal de tentatives avant de marquer une action en échec
EXPO_PUBLIC_SYNC_MAX_RETRIES=5

# ─── GPS / délimitation ────────────────────────────────────
# Précision jugée acceptable pour un point de délimitation, en mètres.
# En dessous de cette valeur le point est accepté sans avertissement.
EXPO_PUBLIC_GPS_ACCURACY_ACCEPTABLE=15

# Précision maximale au-delà de laquelle le point est refusé, en mètres.
# Un GPS grand public ne garantit pas mieux que 5 à 10 m à découvert.
EXPO_PUBLIC_GPS_ACCURACY_MAX=40

# Délai d'obtention d'une position, en millisecondes.
EXPO_PUBLIC_GPS_TIMEOUT=12000
