# Haivoly Frontend — API
# Mode LAN (par défaut, auto-détecté via Constants.hostUri)
# EXPO_PUBLIC_API_URL=http://192.168.2.170:3000

# Mode TUNNEL (mobile en 4G / WiFi différent)
# 1. Lance le backend : npm run start:dev (port 3000)
# 2. Expose le backend : ngrok http 3000  → copie l'URL https://xxxx.ngrok-free.app
# 3. Mets l'URL ngrok ici :
# EXPO_PUBLIC_API_URL=https://a1b2c3.ngrok-free.app
# 4. Lance Expo en tunnel : npx expo start --tunnel --clear

# Mode PROD
# EXPO_PUBLIC_API_URL=https://api.haivoly.mg
